{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Machine Structure Editor",
            "type": "debugpy",
            "request": "launch",
            "module": "machine_builder.app",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}