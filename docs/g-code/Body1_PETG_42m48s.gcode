; EXECUTABLE_BLOCK_START
M73 P0 R42
M201 X4000 Y4000 Z300 E25
M203 X1200000 Y1200000 Z6000 E1500
M204 P30 T4000 ; sets acceleration (P, T), mm/sec^2
M566 X540.00 Y540.00 Z60.00 E150.00 ; sets the jerk limits, mm/min
;TYPE:Custom
; ==== RRF Start G-code for OrcaSlicer ====
M564 H0 S0                                                     ; Allow movement before homing
M190 S70      ; Wait for bed temp
M109 S260              ; Wait for hotend temp

G28                                                                   ; Home all axes
G1 Z5 F6000                                                    ; Raise nozzle
G1 X5 Y5 F6000                                              ; Move to front corner
M73 P10 R38
G92 E0                                                              ; Reset extruder
G1 F300 E3                                                      ; Prime
G92 E0                                                              ; Reset again
G29 S1                                                              ; Load bed mesh compensation

G90
G21
M83 ; use relative distances for extrusion
; Filament gcode
T0 ; change extruder
M106 S0 ; disable fan
